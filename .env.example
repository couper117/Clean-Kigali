# Copy this file to .env and fill in your own values. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=3000

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clean_kigali_dev

# true when the database needs an encrypted connection (Render's external URL).
# Leave empty to use the default: on in production, off otherwise.
DATABASE_SSL=

# Which website may call the API from a browser. * allows any.
CORS_ORIGIN=*

# Separate database used by npm test, so tests never touch your dev data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/clean_kigali_test
