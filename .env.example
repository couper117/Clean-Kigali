# Copy this file to .env and fill in your own values. Never commit .env.

# development | test | production
NODE_ENV=development
PORT=3000

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clean_kigali_dev

# true when the database needs an encrypted connection (Neon, or any hosted database).
# Leave empty to use the default: on in production, off otherwise.
DATABASE_SSL=

# Signs staff login tokens. Use a long random value, at least 32 characters in
# production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts, for example 30m, 8h or 1d.
JWT_EXPIRES_IN=8h

# Which website may call the API from a browser. * allows any.
CORS_ORIGIN=*

# Separate database used by npm test, so tests never touch your dev data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/clean_kigali_test
