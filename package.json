{
  "name": "clean-kigali-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Clean Kigali: residents report sanitation problems and city staff follow them to resolution.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:test": "node scripts/migrate.js --test",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "vercel-build": "node scripts/vercel-build.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@vercel/functions": "^3.10.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
